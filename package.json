{
  "name": "campuslink",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src *.mjs *.mts *.json README.md",
    "server:dev": "node server/dev.cjs",
    "server:start": "node server/dist/index.cjs",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "db:migrate": "node server/dist/cli.cjs migrate",
    "db:seed": "node server/dist/cli.cjs seed-local",
    "db:approve": "node server/dist/cli.cjs approve-user",
    "email:preview": "node server/dist/cli.cjs outbox",
    "ml:demo": "node server/dist/cli.cjs train-demo",
    "ml:train": "node server/dist/cli.cjs train-model",
    "server:build": "node server/build.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^3.9.0",
    "@rive-app/react-canvas": "^4.36.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^12.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "next": "^15.5.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.0.0",
    "recharts": "^3.0.0",
    "swiper": "^14.3.0",
    "tsx": "^4.23.15",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
