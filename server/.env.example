PORT=8000
HOST=0.0.0.0
# Hosting services supply PORT automatically; do not override it on Render.
FRONTEND_URL=http://localhost:3000
# Production: the frontend HTTPS origin, without a trailing slash.
# Empty DATABASE_URL uses persistent SQLite for local development only.
DATABASE_URL=
# Download the project's database CA certificate from Supabase Database Settings.
# Required when the server certificate chain is not trusted by the runtime.
DATABASE_CA_PATH=
SQLITE_PATH=server/data/campuslink.sqlite
STORAGE_PROVIDER=local
STORAGE_DIR=server/data/uploads
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=campuslink-private
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ML_MODEL_PATH=server/models/placement.json
