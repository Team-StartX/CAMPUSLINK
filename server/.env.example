PORT=8000
HOST=0.0.0.0
# Hosting services supply PORT automatically; do not override it on Render.
FRONTEND_URL=http://localhost:3000
DEV_FRONTEND_ORIGINS=
# Development only: comma-separated exact frontend origins for same-Wi-Fi access.
# Production: the frontend HTTPS origin, without a trailing slash.
# Empty DATABASE_URL uses persistent SQLite for local development only.
DATABASE_URL=
# Download the project's database CA certificate from Supabase Database Settings.
# Required when the server certificate chain is not trusted by the runtime.
DATABASE_CA_PATH=
SQLITE_PATH=server/data/campuslink.sqlite
STORAGE_PROVIDER=local
STORAGE_DIR=server/data/uploads
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=campuslink-private
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Enable recorded voice transcription after setting OPENAI_API_KEY.
SPEECH_PROVIDER=disabled
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ML_MODEL_PATH=server/models/placement.json
ML_API_URL=
# Private token generated on the ML service. Never use a NEXT_PUBLIC_ variable.
ML_API_TOKEN=
